{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leguane-landau-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
